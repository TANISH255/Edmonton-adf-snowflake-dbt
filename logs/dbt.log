    as (with base as (
    select * from AZUREDF_DBT_DB.silver.stg_requests
)

select 
    request_number,
    status,
    
    case 
        when status in ('Completed', 'Published', 'Done') then 'Resolved'
        when status in ('Declined', 'Rejected', 'Cancelled') then 'Closed - Not Resolved'
        when status in ('New', 'Under Review', 'In Progress', 'On Hold') then 'Open'
        else 'Unknown'
    end
 as status_category,
    request_creation_date,
    status_date,
    datediff('day', request_creation_date, status_date) as days_to_resolution,
    case 
        when request_details is not null and length(request_details) > 10 then 'Detailed'
        when request_description is not null then 'Has Description'
        else 'Minimal'
    end as request_completeness,
    ingested_at
from base
    )

