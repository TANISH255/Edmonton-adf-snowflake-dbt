    as (select REQUEST_NUMBER,
REQUEST_DESCRIPTION,
REQUEST_DETAILS,
REQUEST_CREATION_DATE,
STATUS,
STATUS_DATE,
INGESTED_AT,

case when request_creation_date is not null and status_date is not null 
then datediff('day', request_creation_date, status_date) 
else null 
end as days_to_status,

case when lower(STATUS) like '%Closed%' and lower(status) like '%not resolved%'then 'Closed - Not Resolved' 
    when lower(STATUS) like '%Closed%' then 'Closed - Not Resolved' 
    when WHEN LOWER(status) LIKE '%resolved%' THEN 'Resolved' 
    else 'Open'
end as status_category 

from AZUREDF_DBT_DB.DBT_DEV_silver.stg_requests
